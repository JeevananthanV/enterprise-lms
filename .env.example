# ==============================================================================
# Enterprise LMS - Environment Configuration Example
# Copy this file to .env before starting the application.
# NEVER commit real credentials or secret keys to version control.
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
DEBUG=True
APP_NAME="Enterprise LMS"
API_V1_STR=/api/v1

# Server Bindings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Relational Database (PostgreSQL)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/enterprise_lms
POSTGRES_DB=enterprise_lms
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Document Database (MongoDB - Optional in Local Development)
# Set MONGODB_ENABLED=false to run completely on PostgreSQL without needing MongoDB running locally.
# When MONGODB_ENABLED=false or MongoDB is unreachable, the system automatically uses PostgreSQL JSON fallback tables.
MONGODB_ENABLED=false
MONGODB_URL=mongodb://root:example@localhost:27017
MONGODB_DB_NAME=enterprise_lms_content

# Ephemeral & Cache Store (Redis)
# Format: redis://[:<password>@]default@<host>:<port>/<db>
REDIS_URL=redis://localhost:6379/0

# Security & Token Lifecycle Configuration
# JWT_SECRET MUST be at least 32 bytes (256 bits) for cryptographic security under HS256.
JWT_SECRET=change-this-to-a-secure-random-secret-key-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Initial Seed Credentials (Local Development Only - leave blank or unset in Production)
SEED_DEMO_USERS=true
SEED_ADMIN_EMAIL=admin@lms.enterprise.local
SEED_ADMIN_PASSWORD=
SEED_INSTRUCTOR_EMAIL=instructor@lms.enterprise.local
SEED_INSTRUCTOR_PASSWORD=
SEED_STUDENT_EMAIL=student@lms.enterprise.local
SEED_STUDENT_PASSWORD=
